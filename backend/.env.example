# Blue Carbon Registry & MRV System - Backend Environment Variables
# Copy this file to .env and modify values as needed

# Application
APP_NAME="Blue Carbon Registry & MRV API"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development

# API
API_V1_PREFIX="/api/v1"
OPENAPI_URL="/openapi.json"
DOCS_URL="/docs"
REDOC_URL="/redoc"

# Server
HOST="0.0.0.0"
PORT=8000

# Database (async URL for application)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/bluecarbon"
# Database (sync URL for Alembic migrations)
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/bluecarbon"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Security - CHANGE IN PRODUCTION!
SECRET_KEY="dev-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# CORS - Frontend origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
CORS_ALLOW_HEADERS="*"

# File Upload
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE=10485760  # 10 MB
ALLOWED_EXTENSIONS=".jpg,.jpeg,.png,.gif,.webp,.pdf,.csv,.json,.geojson,.tif,.tiff"
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/gif,image/webp,application/pdf,text/csv,application/json,application/geo+json,image/tiff"

# Email (optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# Frontend URL (for email links, etc.)
FRONTEND_URL="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100